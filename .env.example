# Copy to .env and fill in values from your Supabase project dashboard.
# https://supabase.com/dashboard/project/_/settings/api

SUPABASE_PROJECT_ID="your-project-id"
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-publishable-key"

# Vite exposes only VITE_* vars to the browser bundle.
VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-publishable-key"

# Public site URL for canonical links and JSON-LD (production domain)
VITE_SITE_URL="https://jesup.cisc.edu"

# Server-only (optional — do not prefix with VITE_)
# SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Supabase email-delivery Edge Function (server-only secrets)
# Verify the sending domain with Resend before enabling production delivery.
# RESEND_API_KEY="re_your-api-key"
# SITE_URL="https://your-production-jesup-domain.example"
# EMAIL_FROM_ADDRESS="cisc@tuskegee.edu"

# Development Web Push (Sprint 11 Phase 2 — development project only)
# Generate keys: npm run generate:vapid-keys
# VITE_VAPID_PUBLIC_KEY="your-vapid-public-key"
# VAPID_PUBLIC_KEY="your-vapid-public-key"
# VAPID_PRIVATE_KEY="your-vapid-private-key"
# VAPID_SUBJECT="mailto:your-contact@example.com"

# Phase 3A AI providers (server-only; never prefix secrets with VITE_)
# OPENAI_API_KEY="your-openai-api-key"
# OPENAI_MODEL="gpt-4.1-mini"
# ANTHROPIC_API_KEY="your-anthropic-api-key"
# ANTHROPIC_MODEL="claude-sonnet-4-20250514"
